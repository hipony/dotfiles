#!/usr/bin/env python3
"""Save and restore the tabs of Ghostty. See docs/specs/2026-11-25-ghostty-tab-restore-design.md."""
import fcntl
import json
import os
import re
import secrets
import subprocess
import sys
import time
from collections import deque
from pathlib import Path
from typing import NamedTuple

MIN_TAB_AGE_SECONDS = 600
RECORD_NAME = re.compile(r"\d+\.json")
SESSION_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
MIN_GHOSTTY = (1, 4, 0)
DEFAULT_RESOURCES_DIR = "/usr/share/ghostty"
WINDOW_TRIES = 5
WINDOW_RETRY_SECONDS = 2
SURFACE_WAIT_SECONDS = 10
SURFACE_POLL_SECONDS = 0.5
STDERR_LOG_LIMIT = 500


class Proc(NamedTuple):
    ppid: int
    comm: str
    start: int


def state_root(home):
    return Path(home) / ".local/state/ghostty-tabs"


def take_restore_lock(root, *, wait):
    """Return restore.lock, open with an exclusive flock. Without wait, return None
    when another process holds the lock. Closing the file releases the lock."""
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    f = open(root / "restore.lock", "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
    except BlockingIOError:
        f.close()
        return None
    return f


def restore_lock_held(root):
    if not (root / "restore.lock").exists():
        return False
    f = take_restore_lock(root, wait=False)
    if f is None:
        return True
    f.close()
    return False


def read_process_table():
    """Return {pid: Proc} from /proc."""
    table = {}
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        try:
            with open(f"/proc/{entry.name}/stat") as f:
                stat = f.read()
        except OSError:
            continue
        # comm sits in parentheses and may contain spaces; split after the last ")".
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        fields = stat[stat.rindex(")") + 2:].split()
        table[int(entry.name)] = Proc(ppid=int(fields[1]), comm=comm, start=int(fields[19]))
    return table


def read_system_state():
    result = subprocess.run(["systemctl", "is-system-running"], capture_output=True, text=True)
    return result.stdout.strip()


def read_uptime():
    return float(Path("/proc/uptime").read_text().split()[0])


def read_boot_id():
    return Path("/proc/sys/kernel/random/boot_id").read_text().strip()


def write_json_atomic(path, data):
    tmp = path.with_name("." + path.name + ".tmp")  # never <digits>.json
    tmp.write_text(json.dumps(data))
    os.replace(tmp, path)


def read_live_records(live_dir, table):
    """Return the records of live tab shells; delete the records of dead ones."""
    records = []
    if not live_dir.is_dir():
        return records
    for path in sorted(live_dir.iterdir()):
        if not RECORD_NAME.fullmatch(path.name):
            continue
        try:
            rec = json.loads(path.read_bytes().decode("utf-8", "surrogateescape"))
            proc = table.get(rec["pid"])
            alive = (proc is not None and proc.start == rec["start"]
                     and isinstance(rec["cwd"], str))
        except (OSError, ValueError, KeyError, TypeError):
            alive = False
        if alive:
            records.append(rec)
        else:
            path.unlink(missing_ok=True)
    return records


def read_claude_record(claude_dir, pid, proc):
    try:
        rec = json.loads((claude_dir / f"{pid}.json").read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(rec, dict) or rec.get("kind") != "interactive":
        return None
    if str(rec.get("procStart", proc.start)) != str(proc.start):
        return None
    if not (isinstance(rec.get("cwd"), str) and isinstance(rec.get("sessionId"), str)):
        return None
    return rec


def find_agent(shell_pid, table, claude_dir, proc_cwd):
    """Return the tab entry fields of the agent nearest to the shell, or None."""
    children = {}
    for pid, proc in table.items():
        children.setdefault(proc.ppid, []).append(pid)
    queue = deque(sorted(children.get(shell_pid, [])))
    while queue:
        pid = queue.popleft()
        proc = table[pid]
        if proc.comm == "claude":
            rec = read_claude_record(claude_dir, pid, proc)
            if rec is not None:
                return {"kind": "claude", "cwd": rec["cwd"], "session": rec["sessionId"]}
        elif proc.comm == "opencode":
            try:
                return {"kind": "opencode", "cwd": proc_cwd(pid), "session": ""}
            except OSError:  # the process exited after the table read
                pass
        queue.extend(sorted(children.get(pid, [])))
    return None


def build_tabs(live_records, table, claude_dir, proc_cwd):
    """Return the tab entries, in tab open order."""
    tabs = []
    for rec in sorted(live_records, key=lambda r: r["start"]):
        agent = find_agent(rec["pid"], table, claude_dir, proc_cwd)
        if agent is not None:
            tabs.append({**agent, "prefill": ""})
        else:
            tabs.append({"kind": "shell", "cwd": rec["cwd"], "session": "",
                         "prefill": rec.get("running") or rec.get("pending") or ""})
    return tabs


def snapshot(home, *, table, proc_cwd, system_state, boot_id, uptime, clk_tck):
    """Write snapshot.json unless a blocking condition holds. Return True on write."""
    root = state_root(home)
    # Delete stale live records even when no write follows.
    live = read_live_records(root / "live", table)
    if system_state == "stopping" or not live or restore_lock_held(root):
        return False
    oldest_age = uptime - min(r["start"] for r in live) / clk_tck
    if not (root / f"restored-{boot_id}").exists() and oldest_age < MIN_TAB_AGE_SECONDS:
        return False
    tabs = build_tabs(live, table, Path(home) / ".claude/sessions", proc_cwd)
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    current = root / "snapshot.json"
    if current.exists():
        # Link, not move: snapshot.json must exist at every moment.
        prev_tmp = root / ".snapshot.prev.json.tmp"
        prev_tmp.unlink(missing_ok=True)
        os.link(current, prev_tmp)
        os.replace(prev_tmp, root / "snapshot.prev.json")
    write_json_atomic(current, tabs)
    return True


def cmd_snapshot():
    snapshot(
        Path.home(),
        table=read_process_table(),
        proc_cwd=lambda pid: os.readlink(f"/proc/{pid}/cwd"),
        system_state=read_system_state(),
        boot_id=read_boot_id(),
        uptime=read_uptime(),
        clk_tck=os.sysconf("SC_CLK_TCK"),
    )


def parse_ghostty_version(text):
    """Return (major, minor, patch) from the first line of `ghostty --version`, or None."""
    m = re.match(r"Ghostty (\d+)\.(\d+)\.(\d+)", text)
    return tuple(int(x) for x in m.groups()) if m else None


def load_tabs(root, log):
    """Return the tab entries to restore, or None when there is nothing to restore."""
    for name in ("snapshot.json", "snapshot.prev.json"):
        path = root / name
        if not path.exists():
            if name == "snapshot.json":
                return None  # absent: no fallback
            continue
        try:
            tabs = json.loads(path.read_text())
            if isinstance(tabs, list):
                return [t for t in tabs if isinstance(t, dict)]
        except (OSError, ValueError):
            pass
        log(f"{name} cannot be parsed")
        if name == "snapshot.json":
            log("falling back to snapshot.prev.json")
    log("both snapshot files are bad")
    return None


def resolve_tab(tab, home, isdir):
    """Return {cwd, run, prefill, note} for one tab entry."""
    kind = tab.get("kind")
    session = str(tab.get("session") or "")
    prefill = str(tab.get("prefill") or "")
    cwd = tab.get("cwd")
    run = ""
    if kind == "claude":
        command = f"claude --resume {session}".rstrip()
        if SESSION_ID.fullmatch(session):
            run = command
        else:
            prefill = command
    elif kind == "opencode":
        run = "opencode"
    note = ""
    if not (isinstance(cwd, str) and isdir(cwd)):
        note = f"directory no longer exists: {cwd}"
        cwd = str(home)
        if run:  # an agent must not start in the wrong directory
            prefill, run = run, ""
    return {"cwd": cwd, "run": run, "prefill": prefill, "note": note}


def build_ghostty_argv(tab, *, action, surface_id, tab_id, integration_dir, user_zdotdir):
    """Return the Ghostty argv that opens one resolved tab. action: +new-window or +new-tab."""
    argv = ["ghostty", action]
    if surface_id:
        argv.append(f"--surface-id={surface_id}")
    argv.append(f"--working-directory={tab['cwd']}")
    values = [("GHOSTTY_TABS_ID", tab_id), ("GHOSTTY_TABS_RUN", tab["run"]),
              ("GHOSTTY_TABS_PREFILL", tab["prefill"]), ("GHOSTTY_TABS_NOTE", tab["note"]),
              ("ZDOTDIR", integration_dir)]
    if user_zdotdir:
        values.append(("GHOSTTY_ZSH_ZDOTDIR", user_zdotdir))
    # +new-tab ignores --working-directory (Ghostty 1.4.0), so env --chdir sets
    # the directory of every tab. One "--chdir=" element: a directory name that
    # starts with "-" is not read as an option. An argv element cannot hold NUL;
    # each value is otherwise raw.
    argv += ["-e", "env", "--chdir=" + tab["cwd"].replace("\0", "")]
    argv += [f"{k}={v}".replace("\0", "") for k, v in values] + ["zsh", "-i"]
    return argv


def ghostty_is_new_enough(get_version, log, notify):
    version_text = get_version()
    version = parse_ghostty_version(version_text)
    if version is None or version < MIN_GHOSTTY:
        msg = "Ghostty 1.4.0 or later is required for restore"
        log(f"{msg} (found {version_text.splitlines()[0] if version_text else 'none'})")
        notify(msg)
        return False
    return True


def zsh_settings(env):
    """The build_ghostty_argv keywords that give a restored zsh the Ghostty shell integration."""
    resources = env.get("GHOSTTY_RESOURCES_DIR") or DEFAULT_RESOURCES_DIR
    return dict(integration_dir=f"{resources}/shell-integration/zsh",
                user_zdotdir=env.get("ZDOTDIR", ""))


def write_marker(root, boot_id):
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    (root / f"restored-{boot_id}").write_text("")


def restore(home, *, mode, boot_id, get_version, env, isdir, new_id, run_ghostty,
            find_surface_id, notify, sleep, monotonic, log):
    """Open one Ghostty tab for each tab entry of snapshot.json. mode: None, "force" or "skip".

    Return "ok", "ghostty-too-old" or "no-window".
    """
    root = state_root(home)
    marker = root / f"restored-{boot_id}"

    if mode == "skip":
        root.mkdir(mode=0o700, parents=True, exist_ok=True)
        if (root / "snapshot.json").exists():
            os.replace(root / "snapshot.json", root / "snapshot.skipped.json")
        (root / "snapshot.prev.json").unlink(missing_ok=True)
        write_marker(root, boot_id)
        return "ok"
    if marker.exists() and mode != "force":
        return "ok"
    if not ghostty_is_new_enough(get_version, log, notify):
        return "ghostty-too-old"
    tabs = load_tabs(root, log)
    if not tabs:
        log("no tabs to restore")
        write_marker(root, boot_id)
        return "ok"

    common = zsh_settings(env)
    surface_id = None
    failed = 0
    for index, tab in enumerate(tabs):
        resolved = resolve_tab(tab, home, isdir)
        if resolved["note"]:
            log(resolved["note"])
        tab_id = new_id()
        if index == 0:
            argv = build_ghostty_argv(resolved, action="+new-window", surface_id=None,
                                      tab_id=tab_id, **common)
            for attempt in range(WINDOW_TRIES):
                if attempt:
                    sleep(WINDOW_RETRY_SECONDS)
                    # A failed call (a timeout, for one) may have opened the
                    # window late: check just before the retry.
                    surface_id = find_surface_id(tab_id)
                    if surface_id:
                        break
                ok, err = run_ghostty(argv)
                if ok:
                    break
                log(f"+new-window failed (try {attempt + 1} of {WINDOW_TRIES}): {err}")
            else:
                msg = "Ghostty did not open a window; run ghostty-tabs restore"
                log(msg)
                notify(msg)
                return "no-window"
            deadline = monotonic() + SURFACE_WAIT_SECONDS
            while True:
                surface_id = surface_id or find_surface_id(tab_id)
                if surface_id or monotonic() >= deadline:
                    break
                sleep(SURFACE_POLL_SECONDS)
            if not surface_id:
                log("surface ID of the first window not found; tabs open without --surface-id")
        else:
            argv = build_ghostty_argv(resolved, action="+new-tab", surface_id=surface_id,
                                      tab_id=tab_id, **common)
            ok, err = run_ghostty(argv)
            if not ok:
                failed += 1
                log(f"+new-tab failed for {tab.get('cwd')}: {err}")
    write_marker(root, boot_id)
    if failed:
        notify(f"{failed} tab(s) failed to restore")
    return "ok"


def restore_here(home, *, surface_id, boot_id, get_version, env, isdir, new_id, run_ghostty,
                 notify, spawn, log):
    """Restore into the window of the calling tab shell (Decision 9).

    Return the cwd, run, prefill and note of tab entry 1 for that shell, or None.
    spawn(child) runs child in a detached process; child opens the other tab entries
    and writes the boot marker last.
    """
    root = state_root(home)
    lock = take_restore_lock(root, wait=False)
    if lock is None:
        return None
    try:
        if not ghostty_is_new_enough(get_version, log, notify):
            return None
        tabs = load_tabs(root, log)
        if not tabs:
            log("no tabs to restore")
            return None
        resolved = [resolve_tab(tab, home, isdir) for tab in tabs]
        for tab in resolved:
            if tab["note"]:
                log(tab["note"])
        common = zsh_settings(env)

        def child():
            failed = 0
            for tab, entry in zip(resolved[1:], tabs[1:]):
                argv = build_ghostty_argv(tab, action="+new-tab", surface_id=surface_id,
                                          tab_id=new_id(), **common)
                ok, err = run_ghostty(argv)
                if not ok:
                    failed += 1
                    log(f"+new-tab failed for {entry.get('cwd')}: {err}")
            write_marker(root, boot_id)
            if failed:
                notify(f"{failed} tab(s) failed to restore")

        spawn(child)
        first = resolved[0]
        return [first["cwd"], first["run"], first["prefill"], first["note"]]
    finally:
        lock.close()  # the child keeps its own copy of the open lock file


def read_ghostty_version():
    try:
        result = subprocess.run(["ghostty", "--version"], capture_output=True, text=True,
                                timeout=30)
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout


def run_ghostty(argv):
    """Run a Ghostty argv. Return (succeeded, stderr text trimmed for the log)."""
    try:
        result = subprocess.run(argv, capture_output=True, text=True, errors="replace",
                                timeout=30)
    except subprocess.TimeoutExpired as exc:
        # str(exc) holds the argv, which holds the prefill: keep it out of the log.
        return False, f"TimeoutExpired after {exc.timeout} s"
    except OSError as exc:
        return False, f"{type(exc).__name__}: {exc.strerror}"
    except subprocess.SubprocessError as exc:
        return False, type(exc).__name__
    return result.returncode == 0, result.stderr.strip()[:STDERR_LOG_LIMIT]


def find_surface_id(tab_id, proc_root="/proc"):
    """Return GHOSTTY_SURFACE_ID of the process whose environment holds GHOSTTY_TABS_ID=tab_id."""
    want = f"GHOSTTY_TABS_ID={tab_id}".encode()
    with os.scandir(proc_root) as entries:
        names = [e.name for e in entries if e.name.isdigit()]
    for name in names:
        if int(name) == os.getpid():
            continue
        try:
            items = (Path(proc_root) / name / "environ").read_bytes().split(b"\0")
        except OSError:
            continue
        if want in items:
            for item in items:
                if item.startswith(b"GHOSTTY_SURFACE_ID="):
                    return item.split(b"=", 1)[1].decode()
    return None


def printable(message):
    """Return message with each undecodable path byte escaped, so a log write cannot fail."""
    return message.encode("utf-8", "surrogateescape").decode("utf-8", "backslashreplace")


def notify_send(message):
    try:
        subprocess.run(["notify-send", "ghostty-tabs", message], timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def make_log(home):
    log_path = state_root(home) / "restore.log"

    def log(message):
        message = printable(message)
        print(message, file=sys.stderr)
        try:
            log_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            with open(log_path, "a") as f:
                f.write(f"{time.strftime('%F %T')} {message}\n")
        except OSError:
            pass

    return log


def spawn_detached(child):
    """Run child in a new session with stdio on /dev/null, and return at once.

    A double fork: the caller does not wait for child, and child keeps no pipe of
    the caller open. Open files, the restore lock among them, stay open in child.
    """
    sys.stdout.flush()
    sys.stderr.flush()
    pid = os.fork()
    if pid:
        os.waitpid(pid, 0)
        return
    try:
        os.setsid()
        if os.fork():
            os._exit(0)
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        child()
    finally:
        os._exit(0)


def cmd_restore_here(surface_id):
    home = Path.home()
    values = restore_here(
        home, surface_id=surface_id, boot_id=read_boot_id(), get_version=read_ghostty_version,
        env=os.environ, isdir=os.path.isdir, new_id=lambda: secrets.token_hex(8),
        run_ghostty=run_ghostty, notify=notify_send, spawn=spawn_detached, log=make_log(home))
    if values:
        text = "\0".join(v.replace("\0", "") for v in values)
        sys.stdout.buffer.write(text.encode("utf-8", "surrogateescape"))


def cmd_restore(mode):
    home = Path.home()
    log = make_log(home)
    # Wait for a restore on the first window (Decision 9); its boot marker then stops this one.
    lock = take_restore_lock(state_root(home), wait=True)
    try:
        return restore(
            home, mode=mode, boot_id=read_boot_id(), get_version=read_ghostty_version,
            env=os.environ, isdir=os.path.isdir, new_id=lambda: secrets.token_hex(8),
            run_ghostty=run_ghostty, find_surface_id=find_surface_id, notify=notify_send,
            sleep=time.sleep, monotonic=time.monotonic, log=log)
    finally:
        lock.close()


def main(argv):
    if argv[1:] == ["snapshot"]:
        cmd_snapshot()
        return 0
    if argv[1:3] == ["restore", "--here"] and len(argv) == 4:
        cmd_restore_here(argv[3])
        return 0
    if argv[1:2] == ["restore"] and argv[2:] in ([], ["--force"], ["--skip"]):
        status = cmd_restore({"--force": "force", "--skip": "skip"}.get(argv[2] if argv[2:] else ""))
        return 0 if status == "ok" else 1
    print("usage: ghostty-tabs snapshot | restore [--force | --skip | --here <surface-id>]",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
